# Enable rewrite engine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect URLs with extra path segments to the base URL
# Example:
# /about/abc            -> /about
# /product-details-x/1  -> /product-details-x
# /blog-detail-y/test   -> /blog-detail-y
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/.+$ /$1 [R=301,L]

# Dynamic SEO routes
RewriteRule ^product-details-(.+)$ corrugatedBox.php/$1 [L,QSA,NC]
RewriteRule ^categories-details-(.+)$ pp-corugatedbox.php/$1 [L,QSA,NC]
RewriteRule ^blog-detail-(.+)$ blog-1.php/$1 [L,QSA,NC]

# Blog Redirects
Redirect 301 /blog-detail-why-choose-professional-plywood-pallets-manufacturers- /blog-detail-why-choose-professional-plywood-pallets-manufacturers

Redirect 301 /blog-detail-Corrugated-Boxes-Manufacturers,-Ensuring-Safe-and-Eco-Friendly-Packaging /blog-detail-corrugated-boxes-manufacturers-ensuring-safe-and-eco-friendly-packaging

Redirect 301 blog-detail-skn-industries-%E2%80%94-an-ace-when-it-comes-to-plywood-pallets-manufacturers /blog-detail-skn-industries-an-ace-when-it-comes-to-plywood-pallets-manufacturers

Redirect 301 /blog-detail-What-Are-Plywood-Pallets-Manufacturers%E2%80%82and-Why-Are-They-in-High-Demand /blog-detail-what-are-plywood-pallets-manufacturers-and-why-are-they-in-high-demand

# Product Redirects
Redirect 301 /product-details-Corrugated-Boxes-Manufacturers /product-details-corrugated-box-manufacturer

Redirect 301 /product-details-Corrugated-Boxes /product-details-corrugated-box-manufacturer

Redirect 301 /product-details-plywood-pallet /product-details-plywood-pallet-manufacturers

# Clean URLs (remove .php extension)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [L]

# Default index file
DirectoryIndex index.php index.html

# Prevent directory listing
Options -Indexes

# Basic security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Protect sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit